{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020"],
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "useUnknownInCatchVariables": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["app.js", "ambient.d.ts", "worker/src/**/*.js"]
}
